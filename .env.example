# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# Per course rules, the app may use ONLY these two key names, spelled exactly.
# Use either PORTKEY_API_KEY (course-provided, gpt-6-luna only) OR OPENAI_API_KEY
# (your own key, used at your own expense) — not both are required, but at
# least one must be set.

# Course-provided key. If set, the app calls gpt-6-luna through Portkey.
PORTKEY_API_KEY=

# Your own OpenAI key, if you are paying for API access yourself instead.
OPENAI_API_KEY=
